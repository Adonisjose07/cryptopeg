# =================================================================
# Stage 1: Build WebAssembly Crytographic Core with Emscripten
# =================================================================
FROM emscripten/emsdk:3.1.61 AS wasm-builder

WORKDIR /src

# Clonar y compilar libsodium estático para WebAssembly
RUN git clone https://github.com/jedisct1/libsodium.git --branch stable --depth 1 && \
    cd libsodium && \
    emconfigure ./configure --enable-minimal --disable-shared && \
    emmake make -j$(nproc)

# Copiar cabeceras y fuentes criptográficas
COPY include/ ./include/
COPY src/stealth.cpp src/ring_signature.cpp src/pedersen.cpp ./src/
COPY bindings/ ./bindings/

# Compilar binario Wasm y runtime JavaScript
RUN mkdir -p /out && \
    em++ -O3 -std=c++20 \
      -I./include \
      -I./libsodium/src/libsodium/include \
      src/stealth.cpp src/ring_signature.cpp src/pedersen.cpp bindings/wasm_bindings.cpp \
      ./libsodium/src/libsodium/.libs/libsodium.a \
      -s WASM=1 \
      -s MODULARIZE=1 \
      -s EXPORT_ES6=0 \
      -s EXPORT_NAME="CryptoPegWasmModule" \
      -s ALLOW_MEMORY_GROWTH=1 \
      -s NO_EXIT_RUNTIME=1 \
      --bind \
      -o /out/cryptopeg_crypto.js

# Stage 2: Exportar artefactos Wasm
FROM alpine:latest
WORKDIR /dist
COPY --from=wasm-builder /out/ /dist/
