# =================================================================
# CRYPTOPEG USDT -- PLANTILLA DE CONFIGURACIÓN DEL NODO
# =================================================================
NODE_ENV=production
NODE_PORT=8080
BUILD_VERSION=1.0.0

# =================================================================
# ROL DEL NODO EN LA RED
# =================================================================
# ENABLE_ORACLE=false  -> Modo Nodo Regular / Validador P2P (Recomendado para usuarios y comunidad)
#                         Valida firmas RingCT MLSAG, propaga transacciones y atiende billeteras.
#                         No requiere conectarse a Arbitrum ni gastar APIs externas.
# ENABLE_ORACLE=true   -> Modo Nodo Oráculo / Validador de Puente L2 (Para operadores del puente)
#                         Vigila el contrato CryptoPegVault en Arbitrum y propone bloques de depósito.
ENABLE_ORACLE=false
ORACLE_POLL_INTERVAL_MS=5000
NODE_DAEMON_URL=http://127.0.0.1:8080

# =================================================================
# SMART CONTRACTS DE CUSTODIA 1:1 (ARBITRUM L2)
# =================================================================
# Direcciones oficiales de los contratos en vivo en Arbitrum Sepolia
USDT_VAULT_ADDRESS=0x0ddFB2b3095DFC50E15bCD37b6A3a786a4DCB3e0
ARBITRUM_USDT_ADDRESS=0x900A96C51aac4EB8aF5FDa39bc0Ef13ADBe88B44
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_ONE_RPC_URL=https://arb1.arbitrum.io/rpc

# Billetera de Tesorería del Administrador (para cobro de comisiones del protocolo)
TREASURY_WALLET_ADDRESS=0x9d59867EfE155406f637F028997866f252dcc72c

# Clave privada para despliegues o interacción con testnet (NUNCA compartir en repositorios)
TESTNET_PRIVATE_KEY=

# Colateral inicial simulado
INITIAL_COLLATERAL_USDT=0.000000

# =================================================================
# COMISIONES DEL POOL (Puntos Básicos: 50 bps = 0.50%)
# =================================================================
DEPOSIT_FEE_BPS=50
WITHDRAW_FEE_BPS=50

# =================================================================
# PARÁMETROS DEL MEZCLADOR MICRO-TUMBLER (DESEMBOLSO ASÍNCRONO)
# =================================================================
TUMBLER_MIN_FRAGMENTS=5
TUMBLER_MAX_FRAGMENTS=15
TUMBLER_MIN_HOPS=2
TUMBLER_MAX_HOPS=4
TUMBLER_POISSON_MEAN_DELAY_MS=250

# =================================================================
# RED DESCENTRALIZADA P2P (GOSSIP MESH & IBD)
# =================================================================
# NODE_ID: Identificador opcional de este nodo (por defecto: generado al azar)
NODE_ID=node-validador-1

# P2P_LISTEN_URL: URL accesible desde los otros nodos (ej: http://192.168.1.50:8080 o http://tu-ip-publica:8080)
P2P_LISTEN_URL=http://127.0.0.1:8080

# P2P_SEED_PEERS: Lista de nodos semilla separados por comas para descubrir la red
P2P_SEED_PEERS=https://seednode.revoturs.net/
