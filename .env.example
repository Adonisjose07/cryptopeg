# Template de Configuración de Nodo Cripto Privado USDT
NODE_ENV=production
NODE_PORT=8080
BUILD_VERSION=1.0.0

# Bóveda de Reserva 1:1 USDT
USDT_VAULT_ADDRESS=0xVaultCollateralReserveUSDT
INITIAL_COLLATERAL_USDT=0.000000

# Comisiones del Pool (en puntos básicos: 50 bps = 0.50%)
DEPOSIT_FEE_BPS=50
WITHDRAW_FEE_BPS=50

# Parámetros del Mezclador (Tumbler) de Microtransacciones
TUMBLER_MIN_FRAGMENTS=5
TUMBLER_MAX_FRAGMENTS=15
TUMBLER_MIN_HOPS=2
TUMBLER_MAX_HOPS=4
TUMBLER_POISSON_MEAN_DELAY_MS=250

# Red P2P y Nodos Semilla (para conectar con otros validadores en red)
# NODE_ID: Identificador opcional de este nodo (por defecto: generado al azar)
NODE_ID=node-validador-1

# P2P_LISTEN_URL: URL accesible desde los otros nodos (ej: http://192.168.1.50:8080 o http://tu-ip-publica:8080)
P2P_LISTEN_URL=http://127.0.0.1:8080

# P2P_SEED_PEERS: Lista de nodos semilla separados por comas para descubrir la red
P2P_SEED_PEERS=https://seednode.revoturs.net

